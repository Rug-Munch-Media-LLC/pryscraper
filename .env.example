# ── Pry Configuration ──
# Copy this to .env and adjust values. All PRY_* vars are auto-loaded.
#
# ── SECRET BACKEND (see secrets_backend.py) ──
# Pry resolves secrets via secrets_backend.get_secret(name). Default backend is gopass.
# Override with PRY_SECRET_BACKEND:
#   gopass (default) - reads from the gopass store under pry/<name>
#   env              - reads from os.environ (PRY_<NAME> or PRY_<name>)
#   file             - reads from PRY_ENV_FILE (default: $PRY_DATA_DIR/.env)
#   auto             - tries gopass, falls back to env (default)
#
# Seed initial secrets (one time):
#   gopass insert -m pry/jwt_secret        # opens editor, paste a strong random value
#   gopass insert -m pry/api_key
#   gopass insert -m pry/x402_wallet      # your receiving EVM/Solana address
#   gopass insert -m pry/x402_facilitator # https://x402.org/facilitator or your own
#
# Per the SECURITY.md contract, NO secrets live in .env in production.
# .env is for local dev and CI only.

# ── Core ──
PRY_HOST=127.0.0.1
PRY_PORT=8002
PRY_URL=http://localhost:8002

# Root directory for Pry's on-disk data (quality, monitors, sessions, etc.).
# Defaults to ~/.pry. Override for production (e.g., /var/lib/pry) or tests (e.g., /tmp/pry-test).
# PRY_DATA_DIR=~/.pry

# ── LLM / AI ──
# Ollama endpoint (used for summarization, categorization, extraction)
PRY_OLLAMA_URL=http://[INTERNAL-LLM-HOST]:11434

# OpenRouter API key (optional — used for vision model queries)
# PRY_OPENROUTER_API_KEY=sk-or-v1-...
#
# ── Scrape LLM backend (cost) ──────────────────────────────────────────────
# Pry routes scrape/extract/parse LLM calls through a fallback chain ordered by
# PRY_LLM_PROVIDER_ORDER (comma-separated, case-insensitive). Each provider must
# have its API key set to be registered (see registry.py). Free/cheap tiers are
# tried first; deepseek (paid) is the reliability backstop LAST.
#
# Recommended chain: free/cheap first -> paid backstop.
#   zai (GLM, cheapest) -> nvidia (free NIM) -> groq (free) -> openrouter (free)
#   -> kimi -> cerebras -> kilocode -> deepseek (paid backstop)
# Only providers whose key resolves make it into the live chain; a missing key
# simply drops that slot. opencode_zen (deepseek-v4-flash-free) is intentionally
# NOT listed — the fleet reserves it as the small_model.
PRY_LLM_PROVIDER_ORDER=zai,nvidia,groq,openrouter,kimi,cerebras,kilocode,deepseek
#
# Per-provider keys. Set as PRY_<NAME>_API_KEY, the standard env var (e.g.
# NVIDIA_API_KEY), or a gopass secret at pry/<name> (all resolved by
# settings._apply_secrets_backend). Never commit real values here.
# PRY_OPENROUTER_API_KEY=sk-or-v1-...       # free OpenRouter models
# PRY_NVIDIA_API_KEY=...                    # free NVIDIA NIM
# PRY_GROQ_API_KEY=...                      # free Groq tier
# PRY_ZAI_API_KEY=...                       # GLM / z.ai (CHEAPEST — add to unlock)
# PRY_CEREBRAS_API_KEY=...                  # free Cerebras tier
# PRY_KIMI_API_KEY=...                      # free Kimi tier
# PRY_KILOCODE_API_KEY=...                  # free KiloCode tier
# PRY_DEEPSEEK_API_KEY=...                  # paid reliability backstop

# ── Web Scraping ──
# FlareSolverr endpoint for Cloudflare bypass
PRY_FLARESOLVERR_URL=http://flaresolverr:8191/v1

# ── Webhook ──
# Secret used to sign job completion webhooks
# PRY_WEBHOOK_SECRET=pry-webhook-secret

# ── Authentication ──
# API key for endpoint authentication. Fail-closed policy (api.py
# PryHttpMiddleware + request_authorized):
#
#   * PRY_API_KEY set   -> EVERY request (loopback or remote) must send
#     `Authorization: Bearer <key>` (or an rmi JWT). Requests without a valid
#     credential get 401.
#
#   * PRY_API_KEY unset -> the API is only reachable from the loopback
#     interface (127.0.0.1 / ::1). Every non-loopback request is rejected
#     with 401, so a keyless instance is never exposed to the internet
#     (e.g. when the Docker port mapping is public).
#
# Proxy/Tor configuration endpoints follow the same rule and are guarded
# explicitly in addition to the middleware: /v1/proxy/configure,
# POST /v1/config and /v1/config/profile/tor reject remote clients that
# cannot present the key (loopback-only when no key is set).
#
# Generate a strong key:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# PRY_API_KEY=

# ── Proxy / Tor ──
# PRY_PROXY_URL=http://proxy:8080
# PRY_PROXY_TYPE=http
# PRY_PROXY_USERNAME=user
# PRY_PROXY_PASSWORD=pass
# PRY_TOR_ENABLED=false
# PRY_TOR_SOCKS5_HOST=tor
# PRY_TOR_SOCKS5_PORT=9050
# Canonical Tor fallback config (used by tor_fallback.py / ultimate_scraper
# `_tier_tor`). Requires a local Tor daemon + the `aiohttp-socks` package:
#   PRY_TOR_HOST=127.0.0.1
#   PRY_TOR_PORT=9050
#   PRY_TOR_TIMEOUT=30.0

# ── Webshare Residential Proxy Pool ──
# Space-separated list of Webshare residential proxies
# (http://user:pass@host:port). Loaded by webshare_proxy.py and exposed
# to the ProxyManager pool/rotation (provider tag: "webshare").
# If unset, the loader falls back to the secrets manager (gopass), path
# configurable via PRY_WEBSHARE_GOPASS_PATH (default: pry/webshare_proxy_list).
# Never commit real credentials here; this is a format example only.
# WEBSHARE_PROXY_LIST="http://user:pass@proxy1.webshare.io:80 http://user:pass@proxy2.webshare.io:80"

# ── Rotation / Retry ──
# PRY_IP_ROTATION=
# PRY_MAX_RETRIES=3
# PRY_MIN_QUALITY=50
# PRY_RATE_LIMIT_RPM=120

# ── Redis ──
# PRY_REDIS_URL=redis://localhost:6379/0

# ── Database ──
# PRY_DATABASE_URL=postgresql+asyncpg://pry:pry@localhost/pry

# ── Stealth ──
# PRY_STEALTH_ENABLED=true
# PRY_RANDOM_USER_AGENT=true
# PRY_WEBDRIVER_OVERRIDE=true
# PRY_CANVAS_NOISE=true
# PRY_WEBRTC_DISABLE=true
# PRY_GEOLOCATION_SPOOF=true
# PRY_MIN_DELAY_MS=500
# PRY_MAX_DELAY_MS=3000

# ── Output ──
# PRY_DEFAULT_FORMAT=markdown
# PRY_MAX_CHARS=100000
# PRY_INCLUDE_LINKS=true

# ── x402 / MCP ──
# PRY_X402_ENABLED=false
# PRY_MCP_ENABLED=true
#
# Multi-chain x402 (CAIP-2): Pry accepts EVM ERC-20 (USDC/USDT/ETH/ARB/WETH),
# Solana SPL (USDC/USDT/SOL) and TRON TRC-20 (USDT/TRX) payments. The
# canonical acceptance table lives in x402/scheme.py (SUPPORTED_ASSETS).
#
# ── Receiving wallets (THE PAYEE) ─────────────────────────────────────────
# The payTo advertised in the 402 manifest MUST be a real treasury address.
# It is sourced from gopass, NOT hardcoded. For the EVM networks, the
# receiving address is the same treasury for every EVM chain (set the value
# from the gopass secret `YOUR_EVM_TREASURY_ADDRESS` — reference the secret
# NAME; never hardcode the value):
#
#   secrets_manager get evm_treasury_address   # the real EVM treasury
#
# Set each PRY_X402_WALLET_* to that value (EVM networks share the treasury).
# Solana/TRON use DISTINCT base58 addresses (an EVM address is NOT valid there)
# — set them only after they are funded and the verifier is reachable.
# A value equal to a genuine placeholder ("pry-default-wallet", "pry-default",
# "0xRMI_PLATFORM_WALLET") or empty is treated as unconfigured and NEVER
# emitted as payTo (fail closed). NOTE: the operator EVM treasury
# 0x1E3AC01d0fdb976179790BDD02823196A92705C9 is a REAL payee, NOT a sentinel —
# never re-add it to X402_PLACEHOLDER_WALLETS (it was once coffer's
# CONFIGURED_WALLET placeholder; that mistake broke configured deployments).
# PRY_X402_WALLET_BASE=
# PRY_X402_WALLET_ETHEREUM=
# PRY_X402_WALLET_ARBITRUM=
# PRY_X402_WALLET_OPTIMISM=
# PRY_X402_WALLET_POLYGON=
# Operator-confirmed PUBLIC payee treasuries (safe as example values — they
# are the addresses invoices settle to; funding them is the operator's
# concern). A value that does not match the network family's address format
# (EVM hex / Solana base58 / TRON T-prefix) is treated as unconfigured and
# never emitted as payTo.
PRY_X402_WALLET_SOLANA=G1uZFfsdxK2PuH2Em5LhRkEcptxHWe4vy5BZak67QyKv
PRY_X402_WALLET_TRON=TYSWXWr24QTe3c99V9dtzhe1aZTneE261p
#
# ── Facilitator wiring (pick EXACTLY ONE mode; never both) ────────────────
# (A) EXTERNAL facilitator (e.g. the coffer / x402.org service): point Pry at
#     it and turn self-facilitation OFF.
#     PRY_X402_SELF_FACILITATE=0
#     PRY_X402_COINBASE_VERIFY=http://coffer:8001/v1/x402/verify
#     PRY_X402_COINBASE_SETTLE=http://coffer:8001/v1/x402/settle
#     PRY_X402_COINBASE_ENABLED=true
#     # Or, for the public x402.org facilitator, keep the default URLs.
#
# (B) SELF-facilitate (chosen for this deployment): Pry verifies EIP-3009
#     authorizations and broadcasts settlement itself using its own key/RPC.
#     PRY_X402_SELF_FACILITATE=1                       # <-- this deployment
#     PRY_X402_FACILITATOR_RPC=https://mainnet.base.org # EVM JSON-RPC (Base)
#     PRY_X402_FACILITATOR_KEY=<gopass YOUR_GAS_PAYER_PRIVATE_KEY>  # gas payer (secret)
#
# IMPORTANT: PRY_X402_FACILITATOR_RPC is the SELF-facilitator's EVM chain RPC,
# NOT a coffer URL. coffer is only used in mode (A). Do not conflate the two.
# Static USD-per-unit quotes for non-1:1 assets. Stablecoins (USDC/USDT/DAI)
# are fixed at 1.0. These static defaults are [REVIEW]: replace with a live
# price oracle before accepting volatile assets for production payments.
# PRY_X402_USD_PER_UNIT_ETH=2500
# PRY_X402_USD_PER_UNIT_WETH=2500
# PRY_X402_USD_PER_UNIT_ARB=0.6
# PRY_X402_USD_PER_UNIT_SOL=140
# PRY_X402_USD_PER_UNIT_MATIC=0.4
# PRY_X402_USD_PER_UNIT_POL=0.4
# PRY_X402_USD_PER_UNIT_TRX=0.15

# ── CAPTCHA Solving ──
# Master toggle. When false, solve_captcha() returns None for every type.
PRY_CAPTCHA_ENABLED=true

# 2captcha-style API key (also compatible with anti-captcha.com / capmonster
# clones). Required for recaptcha_v2 / recaptcha_v3 / hcaptcha / turnstile
# unless a Capsolver key is set. Never commit a real key here.
# PRY_CAPTCHA_2CAPTCHA_API_KEY=

# Capsolver API key (https://www.capsolver.com). Tried after 2captcha-style
# key when both are set.
# PRY_CAPTCHA_CAPSOLVER_API_KEY=

# OCR backend for image captchas: "tesseract" (pytesseract, default) |
# "easyocr" | "auto" (tesseract first, then easyocr).
# Requires the corresponding library to be installed.
PRY_CAPTCHA_OCR_BACKEND=tesseract

# ── Sports Data (sports_data/ package) ──
# Live odds / scores / player stats for betting bots. Two free sources:
#   1. The Odds API (https://the-odds-api.com) — market-standard live odds.
#      Free tier = 500 requests/month; pay-per-call above that is ~$0.01 —
#      NO subscription, NO rate-limit wall on paid calls. Set your key here
#      (also resolved via the secrets backend under "odds_api_key"):
PRY_ODDS_API_KEY=
#
# In-memory TTL for cached odds/stats/scores (seconds). Bots poll
# sub-minute; a ~10s TTL collapses upstream calls ~6x, keeps reads
# sub-100ms, and stretches the free quota.
# PRY_SPORTS_ODDS_CACHE_TTL_SECONDS=10
#
# Sustained upstream budget for The Odds API (requests per minute),
# enforced by a token-bucket rate limiter (sports_data/cache.py). Raise it
# for paid plans — paid calls have no rate-limit wall.
# PRY_SPORTS_ODDS_RATE_LIMIT_RPM=30
#
# ── "Ready for any bot" posture ──
# * Reads are cached: sub-100ms for sub-minute polling (no upstream spam).
# * Upstream cost is pay-per-call at ~$0.01 — no subscription to buy.
# * No rate-limit wall for paid calls: raise PRY_SPORTS_ODDS_RATE_LIMIT_RPM
#   (or build a limiter without a monthly cap) and poll as fast as needed.
# * Bots just GET /v1/sports/* or import sports_data.get_odds() and poll;
#   cache + rate limiter are handled transparently by the sports_data
#   package.

# ── x402 payment gate ──
# Optional per-minute cap on x402 payment-gated calls (paid endpoints verified
# on-chain via X402Middleware). Lower it to rate-limit paid traffic, or leave
# unset to rely on the per-key PRY_RATE_LIMIT_RPM from api_keys_service.
# X402_RATE_LIMIT_PER_MIN=120
