# ══ 13. Compose interpolation only (services are removed in this profile)
# docker-compose.yml still interpolates these before the overlay drops
# postgres/grafana. They are NOT used by the self-host stack; generate real
# values only if you also run the base (operator) profile.
POSTGRES_PASSWORD=unused-selfhost-profile
GRAFANA_PASSWORD=unused-selfhost-profile
