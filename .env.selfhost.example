PRY_X402_PAYAI_SETTLE=1
# RPC endpoints used for settlement / oracle probes.
PRY_X402_ETH_RPC=
PRY_X402_BASE_RPC=
PRY_X402_ARBITRUM_RPC=
PRY_X402_OPTIMISM_RPC=
PRY_X402_POLYGON_RPC=
