PRY_X402_TIMEOUT=30
PRY_X402_AUDIT=1
PRY_X402_EIP712_NAME=USD Coin
PRY_X402_EIP712_VERSION=2
PRY_X402_ATTEST_MAX_AGE=300
PRY_X402_ATTEST_MAX_SKEW=60
# Per-chain wallets (empty = chain disabled).
