# ── Pry self-host profile ─────────────────────────────────────────────
#   cp .env.selfhost.example .env.selfhost
#   ./scripts/selfhost-init.sh
#   docker compose -f docker-compose.yml -f docker-compose.selfhost.yml \
#     --env-file .env.selfhost up -d
#
# EVERY variable below is read by the app (or by the compose files). Values
# are safe defaults for a single box: SQLite, x402 off, MCP on, no proxy.
# The exhaustive settings model is src/pry/core/settings.py; list it with:
#   python -c "from pry.core.settings import settings; print('\n'.join(sorted(settings.model_dump())))"
# Never commit .env.selfhost (it contains PRY_API_KEY).

# ══ 1. Identity — the one required secret ════════════════════════════
# Bearer token for protected endpoints. `selfhost-init.sh` replaces this
# placeholder with `openssl rand -hex 24`. Anyone with it spends your compute.
PRY_API_KEY=replace-me-run-selfhost-init

# ══ 2. Profile, ports, logging ═══════════════════════════════════════
PRY_ENVIRONMENT=prod
PRY_ENV=prod
ENVIRONMENT=prod
PRY_APP_NAME=Pry
PRY_APP_VERSION=
# The entrypoint owns `alembic upgrade head`; leave the in-process auto-run off.
PRY_ALEMBIC_AUTO=0
# Browsers are baked into the image at this path (container-set; mirror only).
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
PRY_HOST=0.0.0.0
PRY_PORT=8002
PRY_SELFHOST_PORT=8002
PRY_BIND=127.0.0.1
PRY_URL=http://localhost:8002
# Public URL advertised in metadata / MCP when behind a TLS proxy.
# PRY_PUBLIC_BASE_URL=https://pry.example.com
PRY_LOG_LEVEL=INFO
PRY_LOG_STRICT_EXTRAS=0
# Refuse to boot as root (the image already runs as uid 1000).
PRY_ALLOW_ROOT=0
# Loopback callers without a key (dev only; leave off in prod).
PRY_ALLOW_KEYLESS_LOOPBACK=0
# Secret backend: env | file | gopass (self-host = env).
PRY_SECRET_BACKEND=env
# Admin surface is off unless both path + secret are set.
# PRY_ADMIN_PATH=/admin-<random>
# PRY_ADMIN_PATH_SECRET=
PRY_ADMIN_LOOPBACK_ONLY=1

# ══ 3. Storage — embedded SQLite on the data volume ══════════════════
# prod refuses SQLite unless this escape hatch is set. Single box = fine.
# Moving to Postgres: set PRY_DATABASE_URL=postgresql://... and
# PRY_SKIP_MIGRATIONS=0 (the entrypoint then runs `alembic upgrade head`).
PRY_ALLOW_SQLITE_PROD=1
PRY_SKIP_MIGRATIONS=1
PRY_BACKUP_BEFORE_MIGRATE=0
# Abort the boot if a pending migration cannot be preceded by a pg_dump.
PRY_REQUIRE_PRE_MIGRATION_BACKUP=0
# PRY_DATABASE_URL=postgresql://pry:CHANGE_ME@postgres:5432/pry
# No Redis container here: the limiter degrades to an in-process bucket.
PRY_REDIS_URL=
PRY_DATA_DIR=/app/pry-data
PRY_CONFIG_FILE=/app/pry-data/config.json
# PRY_BACKUP_DIR=/app/pry-data/backups

# ══ 4. Proxy trust (X-Forwarded-For) ═════════════════════════════════
# Trusted reverse proxies. Docker bridge + loopback. Remove 172.16.0.0/12
# if the API is exposed directly and nothing sanitizes the header.
PRY_TRUSTED_PROXIES=172.16.0.0/12,127.0.0.1,::1

# ══ 5. Scraper behaviour ═════════════════════════════════════════════
PRY_MAX_RETRIES=3
PRY_MIN_QUALITY=20
PRY_RATE_LIMIT_RPM=120
PRY_RETRY_BACKOFF=1.5
PRY_IP_ROTATION=off
PRY_ROTATION_TIMING=per_request
PRY_ROTATION_DELAY_RANGE=0.5,2.0
PRY_ROTATION_USER_AGENT=
PRY_DEFAULT_FORMAT=markdown
PRY_MAX_CHARS=0
PRY_INCLUDE_LINKS=1
PRY_MARKETPLACE_HONOR_ROBOTS=1
PRY_MARKETPLACE_HTTP_RETRIES=2
PRY_MARKETPLACE_USER_AGENT=
PRY_TIKTOK_TRENDING_PLACEHOLDER=0
# Browser stealth flags (leave at defaults unless a site fights back).
PRY_WEBDRIVER_OVERRIDE=1
PRY_CANVAS_NOISE=1
PRY_WEBRTC_DISABLE=0
PRY_GEOLOCATION_SPOOF=0

# ══ 6. Network egress: proxy, Tor, FlareSolverr ══════════════════════
# Self-host ships NO proxy by default (hard Cloudflare targets will fail).
PRY_PROXY_ENABLED=0
PRY_PROXY_TYPE=http
PRY_PROXY_URL=
PRY_PROXY_USERNAME=
PRY_PROXY_PASSWORD=
PROXY_URL=
# Start using a proxy only after these tiers give up.
PRY_PROXY_AFTER_TIERS=2
PRY_TOR_ENABLED=0
PRY_TOR_HOST=127.0.0.1
PRY_TOR_PORT=9050
PRY_TOR_CONTROL_PORT=9051
PRY_TOR_TIMEOUT=30
TOR_ENABLED=0
TOR_SOCKS5_HOST=
TOR_SOCKS5_PORT=
# Browser tier, wired to the bundled sidecar by the compose overlay.
PRY_FLARESOLVERR_URL=http://flaresolverr-pry:8191/v1
# Residential proxy list (optional). gopass path is fleet-only.
WEBSHARE_PROXY_LIST=
PRY_WEBSHARE_GOPASS_PATH=

# ══ 7. CAPTCHA solving (optional) ════════════════════════════════════
PRY_CAPTCHA_ENABLED=0
PRY_CAPTCHA_OCR_BACKEND=tesseract
PRY_CAPTCHA_CAPSOLVER_API_KEY=
PRY_CAPTCHA_NEXTCAPTCHA_API_KEY=
PRY_CAPTCHA_DEATHBYCAPTCHA_USERNAME=
PRY_CAPTCHA_DEATHBYCAPTCHA_PASSWORD=

# ══ 8. LLM extraction (optional; unset = feature unavailable) ════════
# Point at your own Ollama or add any provider key in the fallback chain.
PRY_OLLAMA_URL=
OLLAMA_BASE_URL=
PRY_LLM_PROVIDER_ORDER=
PRY_LLM_TIMEOUT_SECONDS=60
PRY_LLM_RETRY_MAX_ATTEMPTS=3
PRY_LLM_RETRY_BASE_DELAY=1.0
PRY_LLM_RETRY_MAX_DELAY=10.0
PRY_LLM_STREAM_RETRY_ATTEMPTS=3
PRY_LLM_STREAM_RETRY_BACKOFF=1.5
PRY_OPENROUTER_API_KEY=
OPENROUTER_API_KEY=
PRY_OPENAI_API_KEY=
OPENAI_API_KEY=
PRY_ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY=
PRY_GEMINI_API_KEY=
GOOGLE_API_KEY=
PRY_GROQ_API_KEY=
GROQ_API_KEY=
PRY_DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY=
PRY_MISTRAL_API_KEY=
MISTRAL_API_KEY=
PRY_COHERE_API_KEY=
COHERE_API_KEY=
PRY_CEREBRAS_API_KEY=
CEREBRAS_API_KEY=
PRY_KIMI_API_KEY=
KIMI_API_KEY=
PRY_MINIMAX_API_KEY=
MINIMAX_API_KEY=
PRY_NVIDIA_API_KEY=
NVIDIA_API_KEY=
PRY_NOUS_API_KEY=
NOUS_API_KEY=
PRY_SILICONFLOW_API_KEY=
SILICONFLOW_API_KEY=
PRY_ZAI_API_KEY=
ZAI_API_KEY=
PRY_KILOCODE_API_KEY=
KILOCODE_API_KEY=
PRY_KILOCODE_BASE_URL=
KILOCODE_BASE_URL=
PRY_OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_API_KEY=
APIFY_API_KEY=

# ══ 9. x402 payments — OFF for self-host ═════════════════════════════
