# ── Pry self-host profile ────────────────────────────────────────────
# Copy to `.env.selfhost` and use with the self-host compose overlay:
#
#   cp .env.selfhost.example .env.selfhost
#   ./scripts/selfhost-init.sh
#   docker compose -f docker-compose.yml -f docker-compose.selfhost.yml \
#     --env-file .env.selfhost up -d
#
# This is the WHOLE configuration for the self-host profile. It is a
# deliberately small file: everything you do not set here already has a
# working default in docker-compose.selfhost.yml (SQLite, x402 off, MCP on,
# FlareSolverr sidecar). You do not need the full .env.example to self-host.
#
# The self-host API is published on 127.0.0.1:8002. Put a TLS reverse proxy
# in front of it before exposing it to a network you do not control.

# ══════════════════════════════════════════════════════════════════════════
# Identity — the one required secret
# ══════════════════════════════════════════════════════════════════════════

# Bearer token every protected endpoint requires. Generate it with
# `./scripts/selfhost-init.sh` (openssl rand -hex 24) or:
#   openssl rand -hex 24
# Anyone with this key can spend your compute and your proxy budget.
PRY_API_KEY=replace-me-run-selfhost-init

# ══════════════════════════════════════════════════════════════════════════
# Who pays?
# ══════════════════════════════════════════════════════════════════════════
#
# THE SHORT ANSWER: you do, with your own hardware.
#
#   Self-hosted instance  x402 is OFF. There is no per-call charge, no payee
#                        wallet, no facilitator, no gas payer, no settlement
#                        ledger. You are not paying anyone per scrape — you
#                        pay your own bandwidth, CPU and any proxy you
#                        configure.
#   Hosted API            x402 is ON. Keyless calls to paid endpoints get a
#     (api.pryscraper.com) 402 challenge and settle on-chain to the operator
#                        treasury.
#
# The switch is real: PRY_X402_ENABLED=false is read at app assembly by
# pry.api.kill_switches and X402Middleware is never built, so there is no 402
# path to hit. The defaults below are repeated from the compose overlay so
# this file is readable on its own — docker-compose.selfhost.yml sets the
# same values, and its `environment:` block wins over this file.
PRY_X402_ENABLED=false

# The agent surface. Leave ON unless you deliberately do not want /mcp.
# When off, /mcp is not mounted at all (not "mounted but denied").
PRY_MCP_ENABLED=true

# No payee on a self-host instance. Left empty on purpose — Pry fails closed
# and never emits a payTo for an unconfigured wallet.
PRY_X402_WALLET=
PRY_X402_SELF_FACILITATE=0
PRY_X402_FACILITATOR_RPC=
PRY_X402_FACILITATOR_KEY=

# ══════════════════════════════════════════════════════════════════════════
# Ports and addressing
# ══════════════════════════════════════════════════════════════════════════

# Host port to publish. 8002 is the self-host port of record and matches the
# container port and the `pry serve` default, so a self-hoster sees 8002
# everywhere. The hosted Talos deployment publishes 8005 on the host instead
# — that is a deliberate difference, not drift.
PRY_SELFHOST_PORT=8002

# Base URL advertised in API metadata and used as the MCP base_url.
PRY_URL=http://localhost:8002

# Bind address used by the compose overlay's published port. Keep it on
# loopback unless a TLS-terminating proxy sits in front.
PRY_BIND=127.0.0.1

# ══════════════════════════════════════════════════════════════════════════
# Storage — embedded SQLite
# ══════════════════════════════════════════════════════════════════════════

# The profile runs PRY_ENVIRONMENT=prod, and Pry deliberately refuses SQLite
# in prod unless this escape hatch is set. Single-box self-hosting is exactly
# the case it is for. If you add a second replica, move to Postgres and drop
# this (see docs/ops/DEPLOYMENT.md).
PRY_ALLOW_SQLITE_PROD=1

# ══════════════════════════════════════════════════════════════════════════
# Optional: LLM extraction / summarization
# ══════════════════════════════════════════════════════════════════════════
#
# Unset by default — the scrape pipeline works without an LLM; LLM-backed
# extraction is simply unavailable. Point at your own Ollama, or add a key for
# any provider in the fallback chain. See .env.example for the full list.
# PRY_OLLAMA_URL=http://localhost:11434
# OPENROUTER_API_KEY=

# ══════════════════════════════════════════════════════════════════════════
# Optional: proxies and CAPTCHA solving
# ══════════════════════════════════════════════════════════════════════════
#
# The self-host profile ships NO proxy and NO CAPTCHA-solver key: Cloudflare
# sites will return a challenge. That is the honest default — a 0% success
# rate on hard targets is a configuration gap, not a Pry bug. FlareSolverr is
# included and wired up automatically for the softer half of the ladder.
# PRY_PROXY_URL=http://user:pass@host:port
# PRY_CAPTCHA_2CAPTCHA_API_KEY=
