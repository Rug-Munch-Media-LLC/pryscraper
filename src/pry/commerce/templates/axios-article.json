{
  "name": "Axios Article",
  "description": "Extract article content from Axios",
  "site": "axios.com",
  "category": "news",
  "icon": "\ud83d\udcf0",
  "schema": {
    "name": "axios_article",
    "base_selector": "article",
    "fields": [
      {
        "name": "title",
        "selector": "h1",
        "type": "text"
      },
      {
        "name": "author",
        "selector": "[class*='author']",
        "type": "text"
      },
      {
        "name": "published_date",
        "selector": "time",
        "type": "attribute",
        "attribute": "datetime"
      },
      {
        "name": "content",
        "selector": "[class*='content']",
        "type": "text"
      },
      {
        "name": "image_url",
        "selector": "figure img",
        "type": "attribute",
        "attribute": "src"
      }
    ]
  },
  "url_pattern": "*://www.axios.com/*",
  "_license": "MIT",
  "_copyright": "Copyright (c) 2026 Rug Munch Media LLC"
}