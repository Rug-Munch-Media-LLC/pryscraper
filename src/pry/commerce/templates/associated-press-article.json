{
	"name": "AP News Article",
	"description": "Extract article content from Associated Press",
	"site": "apnews.com",
	"category": "news",
	"icon": "\ud83d\udcf0",
	"schema": {
		"name": "ap_article",
		"base_selector": "article",
		"fields": [
			{
				"name": "title",
				"selector": "h1",
				"type": "text"
			},
			{
				"name": "author",
				"selector": "[class*='Author']",
				"type": "text"
			},
			{
				"name": "published_date",
				"selector": "time, [class*='timestamp']",
				"type": "attribute",
				"attribute": "datetime"
			},
			{
				"name": "content",
				"selector": "[class*='Article']",
				"type": "text"
			},
			{
				"name": "image_url",
				"selector": "figure img, [class*='image'] img",
				"type": "attribute",
				"attribute": "src"
			}
		]
	},
	"url_pattern": "*://www.apnews.com/*",
	"_license": "MIT",
	"_copyright": "Copyright (c) 2026 Rug Munch Media LLC"
}
