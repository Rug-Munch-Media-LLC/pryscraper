{
	"name": "Ulta Product",
	"description": "Extract product details from Ulta Beauty",
	"site": "ulta.com",
	"category": "ecommerce",
	"icon": "\ud83d\udc84",
	"schema": {
		"name": "ulta_product",
		"base_selector": ".product-detail",
		"fields": [
			{
				"name": "title",
				"selector": "h1, [class*='product-name']",
				"type": "text"
			},
			{
				"name": "brand",
				"selector": "[class*='brand']",
				"type": "text"
			},
			{
				"name": "price",
				"selector": "[class*='price']",
				"type": "text",
				"transform": "float"
			},
			{
				"name": "rating",
				"selector": "[class*='rating'], .stars",
				"type": "attribute",
				"attribute": "aria-label"
			},
			{
				"name": "review_count",
				"selector": "[class*='reviews']",
				"type": "text",
				"transform": "int"
			},
			{
				"name": "description",
				"selector": "[class*='description']",
				"type": "text"
			},
			{
				"name": "image_url",
				"selector": "[class*='image'] img, .product-image img",
				"type": "attribute",
				"attribute": "src"
			},
			{
				"name": "shade_count",
				"selector": "[class*='shade']",
				"type": "count"
			},
			{
				"name": "in_store_only",
				"selector": "[class*='store']",
				"type": "exists"
			}
		]
	},
	"url_pattern": "*://www.ulta.com/*",
	"_license": "MIT",
	"_copyright": "Copyright (c) 2026 Rug Munch Media LLC"
}
