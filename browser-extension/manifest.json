{
	"manifest_version": 3,
	"name": "Pry — One-Click Scraper",
	"version": "1.0.0",
	"description": "Scrape any webpage with one click. Extract prices, products, reviews, and more. Send directly to your workflow.",
	"permissions": ["activeTab", "storage", "scripting", "notifications"],
	"host_permissions": [],
	"optional_host_permissions": ["https://api.pryscraper.com/*"],
	"action": {
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/icon16.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"background": {
		"service_worker": "background.js",
		"type": "module"
	}
}
