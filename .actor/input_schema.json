{
  "title": "Pry Scraper",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "urls": {
      "title": "URLs to scrape",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https?://"
      }
    },
    "max_pages": {
      "title": "Max pages",
      "type": "integer",
      "default": 10,
      "minimum": 1,
      "maximum": 1000
    },
    "timeout": {
      "title": "Timeout (seconds)",
      "type": "integer",
      "default": 30,
      "minimum": 5,
      "maximum": 120
    },
    "output_format": {
      "title": "Output format",
      "type": "string",
      "default": "markdown",
      "enum": [
        "markdown",
        "html",
        "text"
      ]
    },
    "crawl": {
      "title": "Crawl linked pages",
      "type": "boolean",
      "default": false
    }
  },
  "description": "Scrape any website with Pry's 12-tier fallback chain.",
  "required": [
    "urls"
  ]
}