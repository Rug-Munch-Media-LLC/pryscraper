# Pry Universal Scraper - generated by the Pry Actor Factory.
# Base image ships Playwright + Chromium preinstalled (official Apify
# python-playwright pattern) - browser downloads are never needed here.
FROM apify/actor-python-playwright:3.13

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    poppler-utils \
    tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/app

COPY requirements.lock .
RUN pip install --no-cache-dir --disable-pip-version-check -r requirements.lock \
    && pip install --no-cache-dir --disable-pip-version-check "apify>=2.7"

COPY actor_factory/ actor_factory/
COPY ultimate_scraper.py scraper.py scraping_methods.py proxy_manager.py \
     resilience.py block_detection.py url_guard.py errors.py observability.py \
     settings.py logging_config.py ./
COPY src/main.py src/main.py

CMD ["python", "src/main.py"]
