# Pry — Apify Actor Dockerfile
# Lightweight image for Apify platform deployment.
# Unlike the main Dockerfile, this skips Playwright/Chromium
# (the Apify platform provides browser rendering via Puppeteer).
# Only the HTTP/TLS/cloudscraper tiers are available here.
FROM apify/actor-python:3.12

# Copy everything
COPY --chmod=755 . /usr/src/app

WORKDIR /usr/src/app

# Install runtime dependencies (no dev deps)
RUN pip install --no-cache-dir -r requirements.txt \
    && rm -rf /root/.cache

# Install Apify SDK (not in requirements.txt — only needed for the actor).
# MUST stay >=4: apify_actor.py uses Actor.configuration (Actor.config was
# removed in SDK 3.x). Verified against apify==4.0.1 (installed + lockfile)
# where Actor.configuration exists and Actor.config is gone. 1.7 here was a
# latent platform-crash bug (2026-08-20 audit) — the actor would die on
# startup inside the Apify platform.
RUN pip install --no-cache-dir "apify~=4.0" \
    && rm -rf /root/.cache

# The actor entry point
ENV PRY_ACTOR=true
ENV PYTHONUNBUFFERED=1

# Switch to non-root user (myuser already exists in apify base image)
# Ensure app directory is owned by myuser
RUN chown -R myuser:myuser /usr/src/app

USER myuser

ENTRYPOINT ["python3", "/usr/src/app/.actor/src/main.py"]
