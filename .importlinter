# Architecture boundary contracts for import-linter.
# Ensures domains stay independent and routers stay thin.

[importlinter]
root_packages =
    pry
# Enable ruling on external (non-pry) packages so the upstream boundary below
# can forbid backend/rag/scanner/bot/product internals.
include_external_packages = True

[importlinter:contract:1]
name = Domain independence (no cross-domain imports)
type = forbidden
source_modules =
    pry.api.routers.scraping
    pry.api.routers.commerce
    pry.api.routers.data
    pry.api.routers.integrations
    pry.api.routers.ai
forbidden_modules =
    pry.api.routers.scraping
    pry.api.routers.commerce
    pry.api.routers.data
    pry.api.routers.integrations
    pry.api.routers.ai
except = pry.api.routers.{layer} may import from pry.api.routers.{layer}

[importlinter:contract:2]
name = Routers stay thin (no engine imports in routers)
type = forbidden
source_modules =
    pry.api.routers
forbidden_modules =
    pry.engine.ultimate_scraper
    pry.engine.stealth_engine
    pry.engine.captcha_solver
# [REVIEW] Known/intentional edges until a pry.services layer exists:
# 1. Engine-internal composition: engine.scraper wraps ultimate_scraper, which
#    uses stealth_engine. These edges make EVERY router that touches the
#    scraper (directly, via core.deps DI, or via actors) transitively import
#    the engine internals. The engine's internal composition is not a router
#    thinness problem — the two edges below are exempted so the contract
#    catches what it means to catch: DIRECT router -> engine imports.
# 2. scraping_api builds an UltimateScraper directly (it IS the de-facto
#    service layer); signup solves captchas via commerce.signup.engine.
# Extracting pry.services.scraper is the real long-term fix.
ignore_imports =
    pry.engine.scraper -> pry.engine.ultimate_scraper
    pry.engine.ultimate_scraper -> pry.engine.stealth_engine
    pry.api.routers.scraping.scraping_api -> pry.engine.ultimate_scraper
    pry.api.routers.core.signup -> pry.commerce.signup.engine
    # api.py lifespan shutdown calls close_browsers() — shutdown-only, not a
    # router thinness problem. Remove when pry.services.shutdown exists.
    pry.api.api -> pry.engine.ultimate_scraper
    pry.api.api -> pry.engine.camoufox_integration

[importlinter:contract:3]
name = Core stays pure (no API imports in core)
type = forbidden
source_modules =
    pry.core
forbidden_modules =
    pry.api
    pry.payments

# Canonical source of truth: standards/ARCHITECTURE.md + standards/import-linter.contract.yaml
# [REVIEW] Tooling gap (pre-existing): pry is src-layout installed editable in
# .venv, but the venv has no lint-imports and global lint-imports can't resolve
# src-layout `pry`. This config is dormant until lint-imports runs with the venv.
[importlinter:contract:4]
name = pryscraper never imports backend/rag/scanner/bot/product internals
type = forbidden
source_modules =
    pry
forbidden_modules =
    app
    rugbrain
    rugmunch_scanner
    rugmunchbot
    walletpress
ignore_imports =
