{
  "name": "Fox News Article",
  "description": "Extract article content from Fox News",
  "site": "foxnews.com",
  "category": "news",
  "icon": "\ud83d\udcf0",
  "schema": {
    "name": "fox_article",
    "base_selector": "article",
    "fields": [
      {
        "name": "title",
        "selector": "h1",
        "type": "text"
      },
      {
        "name": "author",
        "selector": "[class*='author']",
        "type": "text"
      },
      {
        "name": "published_date",
        "selector": "time",
        "type": "attribute",
        "attribute": "datetime"
      },
      {
        "name": "content",
        "selector": "[class*='article-body']",
        "type": "text"
      },
      {
        "name": "image_url",
        "selector": "figure img, [class*='image'] img",
        "type": "attribute",
        "attribute": "src"
      }
    ]
  },
  "url_pattern": "*://www.foxnews.com/*"
}