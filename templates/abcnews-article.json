{
  "name": "ABC News Article",
  "description": "Extract article content from ABC News",
  "site": "abcnews.go.com",
  "category": "news",
  "icon": "\ud83d\udcf0",
  "schema": {
    "name": "abc_article",
    "base_selector": "article",
    "fields": [
      {
        "name": "title",
        "selector": "h1",
        "type": "text"
      },
      {
        "name": "author",
        "selector": "[class*='author']",
        "type": "text"
      },
      {
        "name": "published_date",
        "selector": "time, [class*='timestamp']",
        "type": "attribute",
        "attribute": "datetime"
      },
      {
        "name": "content",
        "selector": "[class*='content']",
        "type": "text"
      },
      {
        "name": "image_url",
        "selector": "figure img",
        "type": "attribute",
        "attribute": "src"
      }
    ]
  },
  "url_pattern": "*://www.abcnews.go.com/*"
}