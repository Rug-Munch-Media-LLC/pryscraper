{
  "name": "Wired Article",
  "description": "Extract article content from Wired",
  "site": "wired.com",
  "category": "news",
  "icon": "\ud83d\udcf0",
  "schema": {
    "name": "wired_article",
    "base_selector": ".content",
    "fields": [
      {
        "name": "title",
        "selector": "h1",
        "type": "text"
      },
      {
        "name": "author",
        "selector": "[class*='author']",
        "type": "text"
      },
      {
        "name": "published_date",
        "selector": "time",
        "type": "attribute",
        "attribute": "datetime"
      },
      {
        "name": "content",
        "selector": "[class*='body']",
        "type": "text"
      },
      {
        "name": "image_url",
        "selector": "figure img, [class*='hero'] img",
        "type": "attribute",
        "attribute": "src"
      }
    ]
  },
  "url_pattern": "*://www.wired.com/*"
}